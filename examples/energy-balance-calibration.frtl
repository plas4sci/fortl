"""
0D Energy Balance Model: greenhouse emissivity calibration

Fixing albedo at Earth's real value (0.3), find the effective emissivity
epsilon (<=1) needed for outgoing blackbody radiation to balance absorbed
solar energy at the observed mean surface temperature of 288K. epsilon < 1
represents the fraction of outgoing radiation NOT trapped by the
greenhouse effect: an emissivity-1 (pure blackbody, no atmosphere) planet
can only reach the much colder equilibrium temperature seen in
energy-balance.frtl.

Solved via Newton's method with a central finite-difference derivative.
"""

pi             : Float[Unit[1]] = 3.14159265359
solar_constant : Float[Unit[J / (s * m^2)]] = 1370.0
mean_radius    : Float[Unit[m]] = 371.0e3
sigma          : Float[Unit[J / (s * m^2 * K^4)]] = 5.67e-8

albedo              : Float[Unit[1]] = 0.3
target_temperature  : Float[Unit[K]] = 288.0
step_size           : Float[Unit[1]] = 0.0001

def energy_in(albedo : Float[Unit[1]]) -> Float[Unit[J / s]]:
  return (solar_constant * pi * (mean_radius^2) * ((1.0 : Float[Unit[1]]) - albedo))

# emissivity scales down outgoing radiation: 1.0 is a pure blackbody,
# smaller values mean more heat is trapped by the greenhouse effect
def energy_out(emissivity : Float[Unit[1]], temperature : Float[Unit[K]]) -> Float[Unit[J / s]]:
  return (emissivity * sigma * temperature^4 * (4.0 : Float[Unit[1]]) * pi * mean_radius^2)

# How far energy_in/energy_out are from balancing at the target temperature
def residual(emissivity : Float[Unit[1]]) -> Float[Unit[J / s]]:
  return energy_in(albedo) - energy_out(emissivity, target_temperature)

# Central finite-difference approximation of d(f)/dx at x, for any
# f : Float[Unit[1]] -> Float[Unit[J / s]]
def derivative(f : Float[Unit[1]] -> Float[Unit[J / s]], x : Float[Unit[1]]) -> Float[Unit[J / s]]:
  return (f(x + step_size) - f(x - step_size)) / (step_size + step_size)

# Newton-Raphson method
def newton_step(f : Float[Unit[1]] -> Float[Unit[J / s]], x : Float[Unit[1]]) -> Float[Unit[1]]:
  return x - (f(x) / derivative(f, x))

# Unrolled Newton iteration, starting from a pure-blackbody guess of 1.0
emissivity_0 : Float[Unit[1]] = 1.0
emissivity_1 : Float[Unit[1]] = newton_step(residual, emissivity_0)
emissivity_2 : Float[Unit[1]] = newton_step(residual, emissivity_1)
emissivity_3 : Float[Unit[1]] = newton_step(residual, emissivity_2)
emissivity_4 : Float[Unit[1]] = newton_step(residual, emissivity_3)
emissivity_5 : Float[Unit[1]] = newton_step(residual, emissivity_4)
it = (emissivity_0, (emissivity_1, (emissivity_2, (emissivity_3, (emissivity_4, emissivity_5)))))
