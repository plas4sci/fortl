"""
The ratio of two Vectors over the same space is a Scalar of unknown value, so
the position of x along the segment from p to q can be computed and used
to interpolate again.
"""
p : Float[Unit[s] & Point[Time]] = 10.0
q : Float[Unit[s] & Point[Time]] = 4.0
x : Float[Unit[s] & Point[Time]] = 7.0

t : Float[Unit[1] & Scalar] = (x - p) / (q - p)
y : Float[Unit[s] & Point[Time]] = p + t * (q - p)
it = (t, y)
