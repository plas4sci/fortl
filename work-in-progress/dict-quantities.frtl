"""
Dictionary whose values are graded (unit-carrying) floats, showing
Dict[K, V] composing with fortl's existing Unit/Quantity grading.
"""
speeds : dict[str, Float[Unit[m / s]]] = {"walking": 1.4; "cycling": 6.0}

